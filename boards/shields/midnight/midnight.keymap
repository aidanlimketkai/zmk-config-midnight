#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // These two keys correspond to the two dummy pins in your overlay's kscan block
            bindings = <
                &kp A
                &kp B
            >;
        };
    };
};